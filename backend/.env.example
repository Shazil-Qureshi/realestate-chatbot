# Copy this file to ".env" (same folder) and fill in your real values.
# The real .env file is ignored by Git and must never be uploaded.

# ---------------------------------------------------------------------------
# Gemini
# ---------------------------------------------------------------------------

# Get a key at https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=your_gemini_api_key_here

# Leave these two EMPTY the first time.
#
# Google renames and retires models regularly, so this project does not
# hard-code a name that was true on some past date. Instead:
#
#   1. Paste your key above and save the file.
#   2. Run:  python backend\test_gemini.py
#   3. The script asks Google which models YOUR key can use and prints
#      two lists.
#   4. Copy one name from each list into the two lines below, save, and
#      run the script again.
#
# Keeping the names here rather than inside the code means a future
# rename is a one-line edit, not a code change.

GEMINI_CHAT_MODEL=
GEMINI_EMBEDDING_MODEL=

# ---------------------------------------------------------------------------
# Everything below is added later
# ---------------------------------------------------------------------------

# n8n webhook that receives leads (added on Day 2)
N8N_WEBHOOK_URL=

# true = check lead details, then discard them (the public live demo, Day 3).
# Leave empty on your laptop so leads go to n8n.
LEADS_DEMO_MODE=

# Website addresses allowed to call the backend (CORS), comma-separated
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---------------------------------------------------------------------------
# Rate limiting (Task 3.5, NFR-04, AC-9)
# ---------------------------------------------------------------------------
# These protect the public demo and the Gemini free-tier quota. Every /chat
# question costs two Gemini calls (embed the question, then answer it).
# Leave them out to use the defaults shown. Google does not publish the
# free-tier numbers; they are shown per account at
# https://aistudio.google.com/rate-limit - read yours and lower
# RATE_CHAT_TOTAL_PER_DAY if it is close to your real quota.

# Per visitor:
RATE_CHAT_PER_MINUTE=10
RATE_CHAT_PER_DAY=100
RATE_LEAD_PER_MINUTE=5
RATE_LEAD_PER_DAY=20

# Everyone together. This is the one that protects the quota, and the one a
# faked address cannot get around:
RATE_CHAT_TOTAL_PER_DAY=500

# Set to false to turn rate limiting off (local development only):
RATE_LIMIT_ENABLED=true
